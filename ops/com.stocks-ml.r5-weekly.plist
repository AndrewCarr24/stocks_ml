<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Retired 2026-09-02: the champion's Saturday cycle runs on GitHub Actions
     (.github/workflows/champion.yml). Kept as the fallback schedule: copy to
     ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$UID <plist>`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stocks-ml.r5-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <!-- zsh explicitly, not via the shebang: launchd attributes child processes
         (uv, python) to the job's program for macOS privacy checks, and the
         Full Disk Access grant is on /bin/zsh -->
    <string>/bin/zsh</string>
    <string>/Users/andrewcarr/Documents/projects/stocks_ml.nosync/ops/r5_weekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>6</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/andrewcarr/Documents/projects/stocks_ml.nosync/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrewcarr/Documents/projects/stocks_ml.nosync/logs/launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/andrewcarr</string>
  </dict>
</dict>
</plist>
